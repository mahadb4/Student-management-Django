# Placeholder values only. Never commit real keys or passwords.
SECRET_KEY=local-dev-insecure-secret-key-change-me

AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
AWS_STORAGE_BUCKET_NAME=replace-with-your-bucket-name
AWS_S3_REGION_NAME=us-east-1

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=

GEMINI_ASSIGNMENT_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_ASSIGNMENT_FALLBACK_MODELS=

# Production (docker-compose.prod.yml on EC2): keep the real .env on the server only.
# DB_HOST=<rds-endpoint>
# ALLOWED_HOSTS=<api-domain>,<alb-dns-name>,<ec2-private-ip>
# CORS_ALLOWED_ORIGINS=https://<vercel-app-domain>
# CSRF_TRUSTED_ORIGINS=https://<api-domain>
# USE_X_FORWARDED_PROTO=True
# BACKEND_IMAGE=<account>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>

# Only needed when running outside Docker Compose (Compose points these at its local db/redis containers)
DB_NAME=student_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/1
